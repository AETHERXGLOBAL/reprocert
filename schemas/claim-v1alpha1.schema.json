{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AETHERXGLOBAL/reprocert/main/schemas/claim-v1alpha1.schema.json",
  "title": "ReproCert ReproducibilityClaim v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "reprocert.dev/v1alpha1"},
    "kind": {"const": "ReproducibilityClaim"},
    "metadata": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["command", "checks"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "working_directory": {"type": "string", "default": "."},
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 300
        },
        "expected_exit_code": {"type": "integer", "default": 0},
        "accepted_exit_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer"}
        },
        "container": {"$ref": "#/$defs/container"},
        "evidence": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        }
      },
      "not": {
        "required": ["expected_exit_code", "accepted_exit_codes"]
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "container": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "engine": {"const": "docker", "default": "docker"},
        "image": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]*@sha256:[a-f0-9]{64}$"
        },
        "network": {"const": "none", "default": "none"},
        "read_only_root": {"const": true, "default": true},
        "drop_capabilities": {"const": true, "default": true},
        "no_new_privileges": {"const": true, "default": true},
        "run_as_host_user": {"const": true, "default": true},
        "pids_limit": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 256
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "json",
            "text",
            "stdout",
            "stderr",
            "exit_code",
            "file_sha256",
            "file_size",
            "junit"
          ]
        },
        "path": {"type": "string"},
        "pointer": {"type": "string"},
        "metric": {
          "enum": [
            "tests",
            "failures",
            "errors",
            "skipped",
            "passed",
            "time_seconds"
          ]
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "source", "op", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "op": {
          "enum": ["eq", "ne", "lt", "le", "gt", "ge", "approx", "contains"]
        },
        "expected": {},
        "abs_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
