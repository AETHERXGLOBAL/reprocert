{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AETHERXGLOBAL/reprocert/main/schemas/suite-v1alpha1.schema.json",
  "title": "ReproCert Suite v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "reprocert.dev/suite/v1alpha1"},
    "kind": {"const": "ReproCertSuite"},
    "metadata": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
