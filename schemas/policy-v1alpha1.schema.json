{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AETHERXGLOBAL/reprocert/main/schemas/policy-v1alpha1.schema.json",
  "title": "ReproCert Policy v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "reprocert.dev/policy/v1alpha1"},
    "kind": {"const": "ReproCertPolicy"},
    "metadata": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "properties": {
        "allowed_verdicts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "ERROR"]},
          "default": ["PASS"]
        },
        "require_ci": {"type": "boolean"},
        "require_git_clean": {"type": "boolean"},
        "min_evidence_files": {"type": "integer", "minimum": 0},
        "max_diagnostics": {"type": "integer", "minimum": 0},
        "required_check_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_container": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
